<mxfile host="app.diagrams.net" version="24.0.0"><diagram id="p0" name="Обзор - всё на одной схеме"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p0-3" value="&lt;span style='font-size:26px'&gt;&lt;b&gt;Game Market Platform - общий обзор&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:14px;color:#666'&gt;Контекст + контейнеры на одной схеме&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="60" as="geometry"/></mxCell><mxCell id="p0-4" value="&lt;span style='font-size:18px'&gt;&lt;b&gt;Игрок&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;Покупает и продаёт предметы&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="200" y="60" width="220" height="200" as="geometry"/></mxCell><mxCell id="p0-5" value="&lt;span style='font-size:18px'&gt;&lt;b&gt;Администратор&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;Наполняет каталог предметов&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1000" y="60" width="220" height="200" as="geometry"/></mxCell><mxCell id="p0-6" value="Game Market Platform (docker-compose, сеть market-network)" style="rounded=1;arcSize=2;fillColor=none;strokeColor=#444444;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontColor=#444444;fontStyle=1;fontSize=16;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="300" width="1420" height="1000" as="geometry"/></mxCell><mxCell id="p0-7" value="&lt;span style='font-size:18px'&gt;&lt;b&gt;frontend&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;[Nginx, HTML + CSS + JS, :3000]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;Веб-интерфейс. Отдает страницу и проксирует /api/ на шлюз&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="560" y="350" width="300" height="160" as="geometry"/></mxCell><mxCell id="p0-8" value="&lt;span style='font-size:18px'&gt;&lt;b&gt;api-gateway&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;[Spring Cloud Gateway, :8080]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;Единая точка входа, роутинг по пути запроса&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="560" y="580" width="300" height="170" as="geometry"/></mxCell><mxCell id="p0-9" value="&lt;span style='font-size:18px'&gt;&lt;b&gt;users-service&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;[Spring Boot + JPA, :8081]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;Игроки, кошельки и балансы&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="300" height="170" as="geometry"/></mxCell><mxCell id="p0-10" value="&lt;span style='font-size:18px'&gt;&lt;b&gt;market-service&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;[Spring Boot + JPA, :8082]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;Предметы и лоты. Оркестрирует сделку покупки&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="560" y="880" width="300" height="170" as="geometry"/></mxCell><mxCell id="p0-11" value="&lt;span style='font-size:18px'&gt;&lt;b&gt;notifications-service&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;[Spring Boot, :8083]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;Принимает отчеты о сделках, пишет в лог контейнера&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1080" y="880" width="300" height="170" as="geometry"/></mxCell><mxCell id="p0-12" value="&lt;span style='font-size:18px'&gt;&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;[db, postgres:16-alpine, :5432, том db_data]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;Базы: users_db (users) и app (items, market_lots)&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;size=15;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="300" y="1120" width="300" height="160" as="geometry"/></mxCell><mxCell id="p0-13" value="&lt;b&gt;Открывает сайт&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;[HTTP :3000]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#707070;fontColor=#333333;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0-4" target="p0-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0-14" value="&lt;b&gt;Открывает сайт&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;[HTTP :3000]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#707070;fontColor=#333333;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0-5" target="p0-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0-15" value="&lt;b&gt;Запросы /api/**&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;[HTTP, nginx proxy_pass]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#707070;fontColor=#333333;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p0-7" target="p0-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0-16" value="&lt;b&gt;/api/users/**&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;[HTTP/REST]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#707070;fontColor=#333333;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0-8" target="p0-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0-17" value="&lt;b&gt;/api/market/**&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;[HTTP/REST]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#707070;fontColor=#333333;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p0-8" target="p0-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0-18" value="&lt;b&gt;/api/notifications/**&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;[HTTP/REST]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#707070;fontColor=#333333;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0-8" target="p0-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0-19" value="&lt;b&gt;Списание / зачисление&lt;br&gt;PUT /api/users/{id}/balance&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;[RestTemplate]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#707070;fontColor=#333333;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0-10" target="p0-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0-20" value="&lt;b&gt;Отчет о сделке&lt;br&gt;POST /api/notifications&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;[RestTemplate]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#707070;fontColor=#333333;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0-10" target="p0-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0-21" value="&lt;b&gt;Чтение / запись&lt;br&gt;база users_db&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;[JDBC, Hibernate]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#707070;fontColor=#333333;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0-9" target="p0-12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0-22" value="&lt;b&gt;Чтение / запись&lt;br&gt;база app&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;[JDBC, Hibernate]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#707070;fontColor=#333333;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p0-10" target="p0-12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p0-23" value="Легенда" style="rounded=1;arcSize=2;fillColor=none;strokeColor=#444444;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontColor=#444444;fontStyle=1;fontSize=16;html=1;" vertex="1" parent="1"><mxGeometry x="0" y="1350" width="710" height="90" as="geometry"/></mxCell><mxCell id="p0-24" value="Person" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="1388" width="200" height="40" as="geometry"/></mxCell><mxCell id="p0-25" value="Container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="1388" width="200" height="40" as="geometry"/></mxCell><mxCell id="p0-26" value="База данных" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#438DD5;strokeColor=#3C7FC0;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="1388" width="200" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="C4 L1 - System Context"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p1-3" value="&lt;span style='font-size:26px'&gt;&lt;b&gt;[System Context] Game Market Platform&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:14px;color:#666'&gt;Учебная микросервисная биржа игровых предметов&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1200" height="60" as="geometry"/></mxCell><mxCell id="p1-4" value="&lt;span style='font-size:18px'&gt;&lt;b&gt;Игрок&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;Покупает и продаёт игровые предметы за виртуальную валюту&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="160" y="130" width="260" height="230" as="geometry"/></mxCell><mxCell id="p1-5" value="&lt;span style='font-size:18px'&gt;&lt;b&gt;Администратор&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;[Person]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;Наполняет общий каталог игровых предметов&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="800" y="130" width="260" height="230" as="geometry"/></mxCell><mxCell id="p1-6" value="&lt;span style='font-size:18px'&gt;&lt;b&gt;Game Market Platform&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;[Software System]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;Веб-интерфейс, кошельки игроков, каталог предметов, лоты на продажу, покупка и уведомления о сделках&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="420" y="520" width="380" height="220" as="geometry"/></mxCell><mxCell id="p1-7" value="&lt;b&gt;Регистрируется, выставляет лоты,&lt;br&gt;покупает предметы&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;[HTTP, браузер]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#707070;fontColor=#333333;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-4" target="p1-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1-8" value="&lt;b&gt;Создает предметы&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;[HTTP, браузер]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#707070;fontColor=#333333;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1-5" target="p1-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p1-9" value="Легенда" style="rounded=1;arcSize=2;fillColor=none;strokeColor=#444444;strokeWidth=2;dashed=1;dashPattern=8 4;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontColor=#444444;fontStyle=1;fontSize=16;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="830" width="480" height="90" as="geometry"/></mxCell><mxCell id="p1-10" value="Person" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427B;strokeColor=#052E56;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="868" width="200" height="40" as="geometry"/></mxCell><mxCell id="p1-11" value="Software System (наша система)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#FFFFFF;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="868" width="200" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="C4 L2 - Containers"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageH