" edge="1" parent="1" source="p2-7" target="p2-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-15" value="&lt;b&gt;/api/market/**&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;[HTTP/REST]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#707070;fontColor=#333333;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="p2-7" target="p2-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-16" value="&lt;b&gt;/api/notifications/**&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;[HTTP/REST]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#707070;fontColor=#333333;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-7" target="p2-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-17" value="&lt;b&gt;Списание / зачисление&lt;br&gt;PUT /api/users/{id}/balance&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;[RestTemplate]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#707070;fontColor=#333333;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-9" target="p2-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2-18" value="&lt;b&gt;Отчет о сделке&lt;br&gt;POST /api/notifications&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;[RestTemplate]&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=8;strokeWidth=2;strokeColor=#707070;fontColor=#333333;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2-9" t