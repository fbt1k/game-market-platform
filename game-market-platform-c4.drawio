tems · POST /lots · GET /lots · POST /lots/{id}/buy&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D9BD6;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="430" y="380" width="300" height="170" as="geometry"/></mxCell><mxCell id="p3-7" value="&lt;span style='font-size:18px'&gt;&lt;b&gt;MarketService&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;[@Service]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;createItem, getAllItems, createLot, getActiveLots, buyItem - логика покупки&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D9BD6;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="430" y="640" width="300" height="170" as="geometry"/></mxCell><mxCell id="p3-8" value="&lt;span style='font-size:18px'&gt;&lt;b&gt;RestTemplate&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;[@Bean, RestConfig]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;HTTP-клиент для users- и notifications-service&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D9BD6;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="810" y="640" width="300" height="170" as="geometry"/></mxCell><mxCell id="p3-9" value="&lt;span style='font-size:18px'&gt;&lt;b&gt;ItemRepository&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:13px'&gt;[Spring Data JPA]&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;Entity Item: id, title, rarity&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#85BBF0;strokeColor=#5D9BD6;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="100" y="900" width="300" height="150" as="geometry"/></mxCell><mxCell id="p3-10" value="&lt;span